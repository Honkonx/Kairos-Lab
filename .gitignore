# ── Build artifacts ──
.gradle/
.kotlin/
build/
# Excepción: paquete Kotlin real llamado "build" (no directorio de salida de Gradle).
!app/src/main/java/com/termux/app/ui/studio/build/
!app/src/main/java/com/termux/app/ui/studio/build/*.kt
.build-tools/
.idea/
*.iml
local.properties
*.apk
*.aab
*.log
*.keystore
*.jks

# Rootfs local (build_rootfs.py -> tar.xz copiado a mano en app/src/main/assets/) — binario
# generado en build time, nunca código fuente.
/app/src/main/assets/kairos_rootfs.tar.xz
.externalNativeBuild
.cxx/
*.zip
release/
*.so
!x11-server/libs/**/*.so
__pycache__/
*.pyc

# ── OS files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build vendor de llama.cpp (descargado por la tarea downloadLlamaCpp de gradle, no se versiona)
llama-engine/llama.cpp/
