// builds windows/amd64 por convencion de nombre de archivo (sufijo _windows_amd64, mismo
// mecanismo que un .go con build tags). Ver tools/build-gateway-windows.ps1 para el paso de
// compilacion real.
IDI_ICON1 ICON "kairos_logo.ico"
