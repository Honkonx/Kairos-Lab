{
  "name": "gruvbox-light",
  "settings": [
    {
      "settings": {
        "background": "#FBF1C7",
        "foreground": "#3C3836",
        "lineHighlight": "#F2E5BC",
        "selection": "#EBDBB2",
        "caret": "#3C3836",
        "invisibles": "#BDAE93"
      }
    },
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other, storage, storage.type, storage.modifier",
      "settings": {
        "foreground": "#9D0006"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, punctuation.accessor, punctuation.separator",
      "settings": {
        "foreground": "#9D0006"
      }
    },
    {
      "name": "String",
      "scope": "string, string.quoted, string.template, punctuation.definition.string",
      "settings": {
        "foreground": "#79740E"
      }
    },
    {
      "name": "String escape / interpolation",
      "scope": "constant.character.escape, punctuation.definition.template-expression",
      "settings": {
        "foreground": "#AF3A03"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8F3F71"
      }
    },
    {
      "name": "Constant / language keyword literal",
      "scope": "constant.language, variable.language, support.constant",
      "settings": {
        "foreground": "#8F3F71"
      }
    },
    {
      "name": "Function / method name",
      "scope": "entity.name.function, support.function, meta.function-call",
      "settings": {
        "foreground": "#B57614"
      }
    },
    {
      "name": "Type / class name",
      "scope": "entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class, storage.type.annotation",
      "settings": {
        "foreground": "#B57614"
      }
    },
    {
      "name": "Variable / parameter",
      "scope": "variable, variable.parameter, variable.other",
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "XML/HTML tag",
      "scope": "entity.name.tag, punctuation.definition.tag",
      "settings": {
        "foreground": "#9D0006"
      }
    },
    {
      "name": "XML/HTML attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#B57614"
      }
    },
    {
      "name": "JSON property key",
      "scope": "support.type.property-name, meta.object-literal.key",
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "Punctuation / brackets",
      "scope": "punctuation, punctuation.definition.bracket, punctuation.section",
      "settings": {
        "foreground": "#3C3836"
      }
    },
    {
      "name": "Markdown heading",
      "scope": "markup.heading, entity.name.section.markdown",
      "settings": {
        "foreground": "#9D0006",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#076678"
      }
    },
    {
      "name": "Invalid / deprecated",
      "scope": "invalid, invalid.deprecated",
      "settings": {
        "foreground": "#9D0006",
        "fontStyle": "bold"
      }
    }
  ]
}
