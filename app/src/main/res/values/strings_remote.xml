    <!-- Mensajes de diálogo -->
    <string name="remote_dialog_msg_password_vps_note">Como en un VPS real: mientras esté activado, nadie entra solo con la contraseña — ni siquiera vos desde otro dispositivo sin la clave correspondiente.</string>
    <string name="remote_dialog_msg_cambiar_puerto">sshd corre sin permisos root — solo se admiten puertos 1024-65535.</string>
    <string name="remote_dialog_msg_requerir_clave">El dispositivo va a funcionar como un servidor real (VPS): nadie va a poder entrar por SSH solo con la contraseña — ni siquiera vos desde otro dispositivo sin la clave correspondiente. Verificá antes que ya agregaste tu clave en \"Agregar clave pública\".</string>
    <string name="remote_dialog_msg_permitir_login_root">Esto permite iniciar sesión SSH directamente como root, un riesgo real si el dispositivo queda expuesto a internet (túnel/VPS). Solo activalo si sabés lo que hacés.</string>
    <string name="remote_dialog_msg_borrar_conexion">¿Borrar \"%1$s\" (%2$s@%3$s:%4$d)? Esto no afecta al servidor remoto, solo deja de estar guardada acá.</string>
    <string name="remote_dialog_msg_importar_clave_privada">Se guarda en el dispositivo con permisos restringidos (600). Una vez guardada, Kairos nunca vuelve a mostrarla — solo vas a poder usarla, reemplazarla o borrarla.</string>
    <string name="remote_dialog_msg_borrar_clave_importada">¿Borrar la clave \"%1$s\"? Las conexiones guardadas que la usaban van a pedir contraseña interactiva la próxima vez.</string>
    <string name="remote_dialog_msg_conectar_clave_sesion">La clave NO se guarda en el dispositivo — se usa solo para esta conexión y se borra sola en unos segundos.</string>

