    <string name="config_import_config_title">Importar configuración</string>
    <string name="config_import_config_message">Elegí un archivo kairos-config-*.json exportado antes. Se restaura el registry, las preferencias y la config de módulos — las claves que hayan quedado redactadas en el export (tokens/API keys) NO se tocan, hay que volver a configurarlas a mano.</string>
