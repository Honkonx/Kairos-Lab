    <string name="config_export_config_title">Exportar configuración</string>
    <string name="config_export_config_message">Genera un archivo JSON con el registry, las preferencias de Kairos y la config chica de cada módulo (modo local de n8n, inferencia de Ollama, etc.) en Download/KairosConfig. Los tokens/API keys/contraseñas NO viajan en texto plano — quedan marcados como redactados y hay que volver a configurarlos a mano después de importar.</string>
    <string name="config_btn_export">Exportar</string>
