<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KairosIde" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ide_accent</item>
        <item name="colorPrimaryDark">@color/ide_background</item>
        <item name="colorAccent">@color/ide_accent</item>
        <item name="colorSurface">@color/ide_surface</item>
        <item name="colorOnSurface">@color/ide_text_primary</item>
        <item name="android:windowBackground">@color/ide_background</item>
        <item name="android:statusBarColor">@color/ide_status_bar_bg</item>
        <item name="android:navigationBarColor">@color/ide_status_bar_bg</item>
        <item name="tabStyle">@style/Theme.KairosIde.TabLayout</item>
    </style>

    <!-- Temas seleccionables de Estudio (2026-08-22, ver docs/humano/humano202.md,
         StudioThemePrefs.kt) — independientes del tema del apk (?attr/kairos*), pedido explícito
         del usuario. "Oscuro" mapea ?attr/studio* a los MISMOS valores que Theme.KairosIde ya
         usaba fijo — cero cambio visual para quien no toque el picker nuevo (mismo criterio que
         KairosThemePrefs ya usa para su default). "Claro" es la única variante nueva, fase
         mínima: solo fondo raíz + toolbar + texto de su título, ver comentario en
         studio_colors.xml sobre qué queda pendiente de migrar. -->
    <style name="Theme.Studio.Oscuro" parent="Theme.KairosIde">
        <item name="studioBg">@color/ide_background</item>
        <item name="studioSurface">@color/ide_surface</item>
        <item name="studioTextPrimary">@color/ide_text_primary</item>
    </style>

    <style name="Theme.Studio.Claro" parent="Theme.KairosIde">
        <item name="studioBg">@color/ide_claro_background</item>
        <item name="studioSurface">@color/ide_claro_surface</item>
        <item name="studioTextPrimary">@color/ide_claro_text_primary</item>
    </style>

    <style name="Theme.KairosIde.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabBackground">@color/ide_tab_bar_bg</item>
        <item name="tabIndicatorColor">@color/ide_accent</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabSelectedTextColor">@color/ide_text_primary</item>
        <item name="tabTextColor">@color/ide_text_secondary</item>
        <item name="tabRippleColor">@color/ide_ripple</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">0dp</item>
        <item name="tabPaddingEnd">0dp</item>
    </style>

    <!-- Botón de VirtualKeyboardBar.kt (ide-app) — texto de teclas (Ctrl/Alt/Shift/Tab/Esc),
         sin la caja de sombra/mayúsculas de Material Button estándar, color de fondo/texto se
         actualiza en runtime según el estado sticky (OFF/PENDING/LOCKED). -->
    <style name="VirtualKeyButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ide_text_secondary</item>
        <item name="backgroundTint">@color/ide_surface</item>
        <item name="cornerRadius">6dp</item>
        <item name="rippleColor">@color/ide_ripple</item>
    </style>
</resources>
