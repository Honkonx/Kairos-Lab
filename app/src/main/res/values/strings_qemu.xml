    <string name="qemu_session_name_terminal">QEMU (Terminal)</string>

    <!-- SSH host→VM (hostfwd tcp::2222-:22, ver run_vm.sh) + X11 forwarding por app (ssh -X),
         ver comentario sobre connectSsh() en QemuFragment.kt -->
    <string name="qemu_btn_connect_ssh">🔑 Conectar por SSH…</string>
    <string name="qemu_ssh_dialog_title">Conectar por SSH a la VM</string>
    <string name="qemu_ssh_dialog_message">Usuario del guest (ej. root en Alpine; debian/ubuntu en las cloud images, si cloud-init ya configuró la contraseña/clave). El puerto %1$d del host reenvía al 22 de la VM. Se conecta con \"-X\" — esto habilita X11 forwarding por app: si la VM tiene un servidor X propio, podés abrir programas gráficos individuales de la VM sin necesitar todo el escritorio por VNC.</string>
    <string name="qemu_ssh_username_hint">Usuario (ej. root)</string>
    <string name="qemu_ssh_connect_button">Conectar</string>
    <string name="qemu_ssh_port_closed_title">Todavía no responde en el puerto %1$d</string>
    <string name="qemu_ssh_port_closed_message">No se detectó nada escuchando en 127.0.0.1:%1$d — la VM puede seguir arrancando (TCG sin KVM tarda), o el guest todavía no tiene sshd activo/instalado. Podés intentar igual (el cliente ssh reintentará la conexión real) o esperar a que termine de bootear.</string>
    <string name="qemu_ssh_try_anyway">Intentar igual</string>
    <string name="qemu_session_name_ssh">QEMU (SSH)</string>

    <!-- Instalar programas dentro de la VM vía SSH (pedido explícito del usuario) — corre el
         comando REAL en una terminal visible (no silencioso): la instalación puede pedir
         confirmación/contraseña dentro del guest, y ni el usuario/paquete de sudo están
         garantizados según la imagen (Alpine=apk sin sudo por defecto, Debian/Ubuntu=apt con
         sudo si cloud-init configuró un usuario no-root) — ver connectSsh()/promptConnectSsh()
         para el mismo criterio de honestidad. -->
    <string name="qemu_btn_install_package">📦 Instalar programa en la VM (por SSH)…</string>
    <string name="qemu_install_pkg_title">Instalar programa en la VM</string>
    <string name="qemu_install_pkg_message">Corre el instalador real por SSH en una terminal visible — si el guest pide contraseña de sudo o confirmación, respondé ahí mismo. Elegí el gestor de paquetes según la imagen (apt para Debian/Ubuntu, apk para Alpine).</string>
    <string name="qemu_install_pkg_manager_label">Gestor de paquetes</string>
    <string name="qemu_install_pkg_name_hint">Nombre del paquete (ej. git, htop, python3)</string>
    <string name="qemu_install_pkg_button">Instalar</string>
    <string name="qemu_toast_pkg_name_required">Escribí el nombre del paquete primero</string>
    <string name="qemu_session_name_install">QEMU (Instalar paquete)</string>

    <!-- Control en caliente vía QMP (v1.4.0, ver QmpClient.kt / hallazgo #2 de
