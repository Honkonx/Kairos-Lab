    <string name="qemu_card_download_images_title">IMÁGENES PARA DESCARGAR</string>
    <string name="qemu_download_images_desc">aarch64 = mismo arch que el teléfono (recomendado, sin traducción cruzada de ISA). x86_64 = cross-arch (más lento). Ambas corren sin KVM (TCG software). Alpine bootea directo a login; las cloud images de Debian/Ubuntu están pensadas para cloud-init (pueden pedir configurar usuario/contraseña aparte para loguear por consola).</string>

    <string name="qemu_image_alpine_name">Alpine Linux 3.24 (virt, x86_64)</string>
    <string name="qemu_image_alpine_desc">ISO oficial minimal de Alpine — bootea directo a login root sin cloud-init, ideal para probar la VM headless rápido. Cross-arch en este teléfono (host ARM64) — más lento que la variante aarch64 de abajo.</string>
    <string name="qemu_image_debian_name">Debian 12 (Bookworm) cloud, amd64</string>
    <string name="qemu_image_debian_desc">Imagen cloud oficial de Debian (qcow2, lista para -drive). Pensada para cloud-init — puede necesitar un ISO de semilla con usuario/contraseña para loguear por consola. Cross-arch en este teléfono — más lento que la variante aarch64 de abajo.</string>
    <string name="qemu_image_ubuntu_name">Ubuntu 22.04 LTS (Jammy) cloud, amd64</string>
    <string name="qemu_image_ubuntu_desc">Imagen cloud oficial de Ubuntu Server. Igual que Debian: pensada para cloud-init, puede pedir semilla aparte para loguear por consola. Cross-arch en este teléfono — más lento que la variante aarch64 de abajo.</string>

    <string name="qemu_image_alpine_aarch64_name">Alpine Linux 3.24 (virt, aarch64) ★ recomendado</string>
    <string name="qemu_image_alpine_aarch64_desc">ISO oficial minimal de Alpine para ARM64 — mismo arch que este teléfono, sin traducción cruzada de ISA (más rápida que la variante x86_64). Bootea directo a login root sin cloud-init.</string>
    <string name="qemu_image_debian_aarch64_name">Debian 12 (Bookworm) cloud, arm64 ★ recomendado</string>
    <string name="qemu_image_debian_aarch64_desc">Imagen cloud oficial de Debian para ARM64 (qcow2). Mismo arch que este teléfono — más rápida que la variante amd64 de arriba. Pensada para cloud-init — puede necesitar un ISO de semilla con usuario/contraseña para loguear por consola.</string>
    <string name="qemu_image_ubuntu_aarch64_name">Ubuntu 22.04 LTS (Jammy) cloud, arm64 ★ recomendado</string>
    <string name="qemu_image_ubuntu_aarch64_desc">Imagen cloud oficial de Ubuntu Server para ARM64. Mismo arch que este teléfono — más rápida que la variante amd64 de arriba. Pensada para cloud-init, puede pedir semilla aparte para loguear por consola.</string>

