    <string name="qemu_card_download_images_title">IMÁGENES PARA DESCARGAR</string>
    <string name="qemu_download_images_desc">Guest x86_64 — corren sin KVM (TCG software, lento). Alpine bootea directo a login; las cloud images de Debian/Ubuntu están pensadas para cloud-init (pueden pedir configurar usuario/contraseña aparte para loguear por consola).</string>

    <string name="qemu_image_alpine_name">Alpine Linux 3.24 (virt, x86_64)</string>
    <string name="qemu_image_alpine_desc">ISO oficial minimal de Alpine — bootea directo a login root sin cloud-init, ideal para probar la VM headless rápido.</string>
    <string name="qemu_image_debian_name">Debian 12 (Bookworm) cloud, amd64</string>
    <string name="qemu_image_debian_desc">Imagen cloud oficial de Debian (qcow2, lista para -drive). Pensada para cloud-init — puede necesitar un ISO de semilla con usuario/contraseña para loguear por consola.</string>
    <string name="qemu_image_ubuntu_name">Ubuntu 22.04 LTS (Jammy) cloud, amd64</string>
    <string name="qemu_image_ubuntu_desc">Imagen cloud oficial de Ubuntu Server. Igual que Debian: pensada para cloud-init, puede pedir semilla aparte para loguear por consola.</string>

