    <string name="qemu_card_terminal_title">TERMINAL</string>
    <string name="qemu_terminal_desc">Para usuarios avanzados — abre una terminal ya ubicada en la carpeta de imágenes, para correr qemu-system-x86_64 a mano (ej. con -monitor stdio), inspeccionar archivos o revisar logs.</string>
