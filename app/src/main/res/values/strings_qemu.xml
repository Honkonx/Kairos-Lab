    <string name="qemu_card_qmp_title">CONTROL EN CALIENTE (QMP)</string>
    <string name="qemu_qmp_desc">Controla la VM en curso sin matar el proceso — requiere haberla arrancado (modo consola o VNC) con esta versión de Kairos. Si ninguna VM está corriendo, cada acción te avisa en vez de fallar en silencio.</string>
    <string name="qemu_btn_qmp_powerdown">⏻ Apagar (graceful)</string>
    <string name="qemu_btn_qmp_pause">⏸ Pausar</string>
    <string name="qemu_btn_qmp_resume">▶ Reanudar</string>
    <string name="qemu_btn_qmp_screenshot">📷 Capturar pantalla (QMP)</string>
    <string name="qemu_btn_qmp_change_media">💿 Cambiar medio (hot-swap)…</string>
    <string name="qemu_btn_qmp_eject_media">⏏ Expulsar medio…</string>

    <string name="qemu_qmp_unavailable_title">No hay ninguna VM con QMP habilitado</string>
    <string name="qemu_qmp_unavailable_message">No se encontró el socket de control de ninguna VM corriendo. Arrancá la VM primero (\"Arrancar VM…\") — el socket QMP se habilita automático en cualquier modo (consola o VNC).</string>

    <string name="qemu_qmp_powerdown_title">Apagar la VM (graceful)</string>
    <string name="qemu_qmp_powerdown_message">Le pide al guest que se apague solo (ACPI powerdown), como apretar el botón de power de una PC real — a diferencia de \"Detener VM\", que mata el proceso QEMU entero de golpe. Un guest headless minimalista sin acpid podría no responder a esto; si no pasa nada en unos segundos, usá \"Detener VM\".</string>
    <string name="qemu_qmp_powerdown_button">Apagar</string>
    <string name="qemu_toast_qmp_powerdown_sent">Señal de apagado enviada — esperá a que el guest cierre solo</string>
    <string name="qemu_toast_qmp_failed">No se pudo completar la acción — revisá que la VM siga corriendo</string>
