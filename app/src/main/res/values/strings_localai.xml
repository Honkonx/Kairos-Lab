    <string name="localai_model_qwen34b_name">Qwen3 4B Instruct</string>
    <string name="localai_model_qwen34b_desc">Última generación de Qwen, mejoras de razonamiento sobre Qwen2.5 en tamaño similar.</string>

    <string name="localai_model_gemma34b_name">Gemma 3 4B IT</string>
