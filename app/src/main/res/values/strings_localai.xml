    <string name="localai_model_phi4mini_name">Phi-4 Mini Instruct</string>
    <string name="localai_model_phi4mini_desc">Versión chica del modelo de razonamiento de Microsoft — mismo linaje que Phi-4 14B con mucho menos RAM.</string>

    <string name="localai_model_deepseekr17b_name">DeepSeek R1 Distill Qwen 7B</string>
    <string name="localai_model_deepseekr17b_desc">Versión 7B del modelo de razonamiento de DeepSeek — respuestas más elaboradas paso a paso.</string>

    <string name="localai_model_qwen38b_name">Qwen3 8B</string>
    <string name="localai_model_qwen38b_desc">Versión 8B de Qwen3 — mejor calidad que la de 4B, pide más RAM.</string>

    <string name="localai_model_mistralnemo12b_name">Mistral NeMo 12B Instruct</string>
    <string name="localai_model_mistralnemo12b_desc">Colaboración Mistral AI + NVIDIA, contexto largo (128K), 12B.</string>

    <string name="localai_model_gemma312b_name">Gemma 3 12B IT</string>
    <string name="localai_model_gemma312b_desc">Versión grande de Gemma 3 — mejor razonamiento que la de 4B, pide bastante más RAM.</string>

    <string name="localai_model_qwencoder14b_name">Qwen2.5 Coder 14B Instruct</string>
