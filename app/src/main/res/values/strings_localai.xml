    <!-- LocalAIFragment.kt — catálogo de modelos GGUF -->
    <string name="localai_model_qwen05b_name">Qwen2.5 0.5B Instruct</string>
    <string name="localai_model_qwen05b_desc">El más chico y rápido del catálogo — ideal para probar el motor local en cualquier equipo.</string>

    <string name="localai_model_tinyllama11b_name">TinyLlama 1.1B Chat</string>
    <string name="localai_model_tinyllama11b_desc">Uno de los modelos más livianos que existen en GGUF — arranca rápido en cualquier gama.</string>

    <string name="localai_model_smollm217b_name">SmolLM2 1.7B Instruct</string>
    <string name="localai_model_smollm217b_desc">Modelo de HuggingFaceTB entrenado para correr bien en dispositivos con poca RAM.</string>

    <string name="localai_model_qwencoder15b_name">Qwen2.5 Coder 1.5B Instruct</string>
    <string name="localai_model_qwencoder15b_desc">Variante de Qwen2.5 especializada en código, tamaño chico para autocompletar/explicar snippets.</string>

    <string name="localai_model_qwen15b_name">Qwen2.5 1.5B Instruct</string>
    <string name="localai_model_qwen15b_desc">Balance entre velocidad y calidad de respuesta, buen default para gama media.</string>

    <string name="localai_model_llama321b_name">Llama 3.2 1B Instruct</string>
    <string name="localai_model_llama321b_desc">Modelo oficial de Meta, cuantizado por bartowski — buena calidad para su tamaño.</string>

    <string name="localai_model_gemma22b_name">Gemma 2 2B IT</string>
    <string name="localai_model_gemma22b_desc">Modelo de Google, buen desempeño en español y razonamiento general.</string>

    <string name="localai_model_qwencoder3b_name">Qwen2.5 Coder 3B Instruct</string>
    <string name="localai_model_qwencoder3b_desc">Versión mediana del modelo de código de Qwen — más contexto útil que la de 1.5B.</string>

    <string name="localai_model_qwen3b_name">Qwen2.5 3B Instruct</string>
    <string name="localai_model_qwen3b_desc">Escalón intermedio entre el 1.5B y el 3.2 de Llama — buen equilibrio de RAM/calidad.</string>

    <string name="localai_model_llama323b_name">Llama 3.2 3B Instruct</string>
    <string name="localai_model_llama323b_desc">Mejor calidad de respuesta que los anteriores, pero pedí más RAM y espacio.</string>

    <string name="localai_model_phi3mini_name">Phi-3 Mini 4K Instruct</string>
    <string name="localai_model_phi3mini_desc">Modelo de Microsoft (3.8B), fuerte en razonamiento para su tamaño, contexto de 4K tokens.</string>

    <string name="localai_model_phi35mini_name">Phi-3.5 Mini Instruct</string>
    <string name="localai_model_phi35mini_desc">Sucesor del Phi-3 Mini, mismo tamaño (3.8B) con mejoras de calidad de Microsoft.</string>

    <string name="localai_model_qwen7b_name">Qwen2.5 7B Instruct</string>
    <string name="localai_model_qwen7b_desc">Modelo mediano de Alibaba, buena relación calidad/tamaño para razonamiento general.</string>

    <string name="localai_model_qwencoder7b_name">Qwen2.5 Coder 7B Instruct</string>
    <string name="localai_model_qwencoder7b_desc">Versión grande del modelo de código de Qwen — mejor para tareas de programación complejas.</string>

    <string name="localai_model_mistral7b_name">Mistral 7B Instruct v0.3</string>
    <string name="localai_model_mistral7b_desc">Modelo de referencia de Mistral AI, clásico confiable en el rango 7B.</string>

    <string name="localai_model_openhermes7b_name">OpenHermes 2.5 Mistral 7B</string>
    <string name="localai_model_openhermes7b_desc">Fine-tune comunitario de Mistral 7B, muy usado para chat de propósito general.</string>

    <string name="localai_model_llama38b_name">Meta Llama 3 8B Instruct</string>
    <string name="localai_model_llama38b_desc">Generación anterior del Llama de Meta en 8B — todavía muy usado como referencia.</string>

    <string name="localai_model_llama318b_name">Meta Llama 3.1 8B Instruct</string>
    <string name="localai_model_llama318b_desc">Modelo oficial de Meta, referencia de calidad en el rango 8B.</string>

    <string name="localai_model_gemma29b_name">Gemma 2 9B IT</string>
    <string name="localai_model_gemma29b_desc">Versión grande de Gemma 2 — mejor razonamiento que la de 2B, pide bastante más RAM.</string>

    <string name="localai_model_qwen14b_name">Qwen2.5 14B Instruct</string>
    <string name="localai_model_qwen14b_desc">El más grande del catálogo — mejor calidad, pero pedí bastante RAM (8GB+ recomendado) y espacio.</string>

    <string name="localai_model_phi414b_name">Phi-4 14B</string>
    <string name="localai_model_phi414b_desc">Modelo de razonamiento de Microsoft (14B) — de los de mejor calidad del catálogo.</string>

