<?xml version="1.0" encoding="utf-8"?>
<!-- Card de archivo/carpeta del grid de Nube — adaptado 1:1 de la ".file-card" de
     ver/nube/nube_personal_web.html (icono+badge arriba, nombre, meta, pie con
     extensión + acciones). Reemplaza el row de lista plana que usaba item_file_row.xml
     (compartido con FileManagerFragment, no se tocó ese archivo — ver
     .claude/rules/docs-folder-organization.md sobre no romper otras pantallas). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nube_file_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/kairosBg2"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/kairosBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Icono de categoría + badge (cifrado / extensión) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nube_card_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_file_icon"
                android:gravity="center"
                android:textSize="18sp"
                tools:text="🖼" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/nube_card_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nube_pill_neutral"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="?attr/kairosAmber"
                android:visibility="gone"
                tools:text="🔒 Cifrado"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/nube_card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textColor="?attr/kairosText"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="fotografia_respaldo_2026.png" />

        <TextView
            android:id="@+id/nube_card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/kairosText3"
            android:textSize="11sp"
            tools:text="4.8 MB · 27/07/26 14:30" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="?attr/kairosDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nube_card_ext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="?attr/kairosText3"
                android:textSize="10sp"
                tools:text="PNG" />

            <TextView
                android:id="@+id/nube_card_menu_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_file_icon"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⋮"
                android:textColor="?attr/kairosText2"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nube_card_delete_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_file_icon"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🗑"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
