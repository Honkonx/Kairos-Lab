<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/module_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/kairosBg2"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:contentPadding="0dp"
        app:strokeColor="?attr/kairosBorder"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Badge de estado superpuesto (esquina inferior-derecha, patrón Proxmox VE
                     — ver docs/humano/humano194.md): el ícono se mantiene fijo, un punto chico de
                     color comunica el Status sin recolorear toda la fila; el borde
                     kairosBg2 (mismo fondo que la card) lo "recorta" visualmente sobre el
                     ícono en vez de quedar pegado sin separación. -->
                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp">

                    <ImageView
                        android:id="@+id/module_icon"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/kairosBg3"
                        android:importantForAccessibility="no"
                        app:tint="@android:color/white"
                        tools:src="@drawable/ic_module_ollama" />

                    <View
                        android:id="@+id/module_status_badge"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/module_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/kairosText"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Ollama" />

                    <TextView
                        android:id="@+id/module_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/kairosText3"
                        android:textSize="12sp"
                        tools:text="— No instalado" />

                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/module_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="?attr/kairosText"
                    android:trackTint="?attr/kairosStatusNotInstalled" />

                <TextView
                    android:id="@+id/module_chevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textSize="20sp"
                    android:textColor="?attr/kairosText3"
                    android:importantForAccessibility="no" />

            </LinearLayout>

            <View
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="?attr/kairosGreen"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
