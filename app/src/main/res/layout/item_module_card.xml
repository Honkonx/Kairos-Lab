<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/kairosBg2"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/module_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/module_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/kairosText"/>

        <TextView
            android:id="@+id/module_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="?attr/kairosText3"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/module_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingHorizontal="7dp"
        android:paddingVertical="3dp"
        android:visibility="gone"/>

    <ToggleButton
        android:id="@+id/module_toggle"
        android:layout_width="40dp"
        android:layout_height="22dp"
        android:background="@drawable/toggle_track_bg"
        android:textOff=""
        android:textOn=""
        android:checked="false"/>

    <TextView
        android:id="@+id/module_action"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textSize="20sp"
        android:textColor="?attr/kairosGreen"
        android:textStyle="bold"
        android:visibility="gone"/>

</LinearLayout>
