<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kairosBg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/kairosBg2"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:contentPadding="0dp"
            app:strokeColor="?attr/kairosBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/general_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="TERMINAL"
            android:textColor="?attr/kairosText3"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/kairosBg2"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:contentPadding="0dp"
            app:strokeColor="?attr/kairosBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/terminal_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="INFO DEL SISTEMA"
            android:textColor="?attr/kairosText3"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/kairosBg2"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:contentPadding="0dp"
            app:strokeColor="?attr/kairosBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="VARIABLES DE ENTORNO"
            android:textColor="?attr/kairosText3"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/kairosBg2"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:contentPadding="0dp"
            app:strokeColor="?attr/kairosBorder"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/env_vars_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btn_add_env_var"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="＋ Agregar variable"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="MANTENIMIENTO"
            android:textColor="?attr/kairosText3"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/btn_rerun_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="\u21BB Re-ejecutar setup"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_backup_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="\u2601 Backup completo"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_export_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="⬆ Exportar configuración"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_import_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="⬇ Importar configuración"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_export_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosBg3"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="📋 Exportar diagnóstico"
            android:textColor="?attr/kairosText"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_reinstall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/kairosRed"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:text="\u26A0 Reinstalar stack"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
