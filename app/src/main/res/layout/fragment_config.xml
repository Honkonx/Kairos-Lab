<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kairosBg"
    android:orientation="vertical">

    <!-- Pestañas por categoría (reorganización 2026-09-03, pedido explícito del usuario:
         "hacer como en mini pc, ssh, base de datos, pestañas por categorías") — mismo estilo
         visual que EntornoFragment/fragment_file_manager.xml (indicador kairosGreen, texto
         kairosText3/kairosText). Cada card de abajo se mantiene tal cual estaba, solo se
         reparte entre 6 contenedores de pestaña en vez de apilarse todas juntas. -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/config_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/kairosBg2"
        app:tabMode="scrollable"
        app:tabTextColor="?attr/kairosText3"
        app:tabSelectedTextColor="?attr/kairosText"
        app:tabIndicatorColor="?attr/kairosGreen" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════ Pestaña GENERAL ═══════════════ -->
            <LinearLayout
                android:id="@+id/tab_general"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="GENERAL"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/kairosBg2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="?attr/kairosBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/general_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ═══════════════ Pestaña INTERFAZ ═══════════════ -->
            <LinearLayout
                android:id="@+id/tab_interfaz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="INTERFAZ"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/kairosBg2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="?attr/kairosBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/interfaz_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ═══════════════ Pestaña TERMINAL ═══════════════ -->
            <LinearLayout
                android:id="@+id/tab_terminal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="TERMINAL"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/kairosBg2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="?attr/kairosBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/terminal_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ═══════════════ Pestaña SISTEMA (info + variables de entorno) ═══════════════ -->
            <LinearLayout
                android:id="@+id/tab_sistema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="INFO DEL SISTEMA"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/kairosBg2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="?attr/kairosBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/info_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="VARIABLES DE ENTORNO"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/kairosBg2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:contentPadding="0dp"
                    app:strokeColor="?attr/kairosBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/env_vars_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/btn_add_env_var"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="＋ Agregar variable"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ═══════════════ Pestaña MANTENIMIENTO ═══════════════ -->
            <LinearLayout
                android:id="@+id/tab_mantenimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp"
                    android:text="MANTENIMIENTO"
                    android:textColor="?attr/kairosText3"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/btn_rerun_setup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="↻ Re-ejecutar setup"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_backup_full"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="☁ Backup completo"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_export_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="⬆ Exportar configuración"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_import_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="⬇ Importar configuración"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_export_diagnostics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosBg3"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="📋 Exportar diagnóstico"
                    android:textColor="?attr/kairosText"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_reinstall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/kairosRed"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="12dp"
                    android:text="⚠ Reinstalar stack"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ═══════════════ Pestaña NOTIFICACIONES (Telegram) ═══════════════ -->
            <!-- Poblada 100% en Kotlin por setupTelegramSection() — mismo criterio que ya
                 usaba esta sección antes de la reorganización en tabs (sin XML propio). -->
            <LinearLayout
                android:id="@+id/tab_notificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
