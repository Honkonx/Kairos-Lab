<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/kairosBg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERSIÓN"
            android:textSize="10sp"
            android:textColor="?attr/kairosText3"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/kairosBg2"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="10dp"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/version_stack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kairos v0.3.0"
                    android:textSize="11sp"
                    android:textColor="?attr/kairosText2"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/version_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API 35 · nativo"
                    android:textSize="11sp"
                    android:textColor="?attr/kairosText3"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
