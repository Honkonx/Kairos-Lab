<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews del widget de home screen "Homelab" — ver HomelabWidgetProvider.kt.
     Solo vistas soportadas por RemoteViews (LinearLayout/TextView), sin ConstraintLayout ni
     vistas custom. Todo el widget es un único target de tap (abre Kairos en Homelab). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_homelab_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_homelab_title"
        android:textColor="@color/widget_homelab_text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_cpu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_homelab_text_primary"
            android:textSize="12sp"
            tools:ignore="HardcodedText"
            tools:text="CPU 12%" />

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widget_homelab_text_primary"
            android:textSize="12sp"
            tools:ignore="HardcodedText"
            tools:text="RAM 43%" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_modules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/widget_homelab_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        tools:text="3 módulos corriendo" />

    <TextView
        android:id="@+id/widget_updated_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widget_homelab_text_secondary"
        android:textSize="10sp"
        tools:ignore="HardcodedText"
        tools:text="Actualizado 10:32" />

</LinearLayout>
