<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de identidad Rocky Linux (2026-08-27) — interpretación
     vectorial simplificada de un solo color (montaña/pico, evocando el nombre "Rocky").
     Recoloreado (ronda "mejorar Mini PC", logos oficiales reales): la montaña EN SU COLOR
     (#6DA34D) sobre fondo claro — antes era al revés (blanca sobre un círculo verde). El
     facetado interior (segundo path) ahora queda del color del badge claro (blanco fijo, ver
     DistroIcons.useLightBadge()) en vez de verde, para conservar el efecto de "faceta
     recortada" sin quedar invisible contra la montaña, ya del mismo verde. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#6DA34D"
        android:pathData="M12,4 L20,20 H4 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,4 L15.3,10.6 L12,13 L8.7,10.6 Z" />
</vector>
