    <string name="languages_item_kotlin_name">Kotlin</string>
    <string name="languages_item_kotlin_note">kotlinc compiler · native Termux, requires JDK (apt dependency of the package)</string>

    <string name="languages_card_already_installed_title">ALREADY INSTALLED SEPARATELY</string>
