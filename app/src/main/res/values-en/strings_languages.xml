    <string name="languages_action_npm_packages">npm -g packages</string>

    <string name="languages_item_perl_name">Perl</string>
    <string name="languages_item_perl_note">Native Termux · dependency of PSQL Format (Packages module)</string>
    <string name="languages_action_perl_config">Config (perl -V)</string>

    <string name="languages_item_php_name">PHP</string>
    <string name="languages_item_php_note">Native Termux CLI</string>
    <string name="languages_action_php_modules">Loaded modules (php -m)</string>

    <string name="languages_item_rust_name">Rust</string>
    <string name="languages_item_rust_note">rustc + cargo, precompiled ARM64 · native Termux</string>
    <string name="languages_action_cargo_binaries">cargo install binaries</string>

    <string name="languages_item_clang_name">C/C++ (Clang)</string>
    <string name="languages_item_clang_note">Native Termux compiler</string>

    <string name="languages_item_golang_name">Go</string>
    <string name="languages_item_golang_note">Compiler + toolchain · native Termux</string>
    <string name="languages_action_go_env">Environment (go env)</string>

    <string name="languages_item_ruby_name">Ruby</string>
    <string name="languages_item_ruby_note">Includes gem · native Termux</string>
