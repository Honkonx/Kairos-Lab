    <string name="languages_screen_name">Languages</string>
    <string name="languages_intro_text">Native Termux programming languages, no proot — real installation via pkg install. All of them are also available separately, with their own apt install, inside a full Linux distro (proot, Environment/Stacks module) if you use one.</string>
