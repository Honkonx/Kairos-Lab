    <string name="config_export_config_title">Export configuration</string>
    <string name="config_export_config_message">Generates a JSON file with the registry, Kairos preferences and each module\'s small config (n8n local mode, Ollama inference, etc.) in Download/KairosConfig. Tokens/API keys/passwords do NOT travel in plain text — they\'re marked as redacted and need to be reconfigured by hand after importing.</string>
