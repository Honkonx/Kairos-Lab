    <string name="qemu_card_download_images_title">IMAGES TO DOWNLOAD</string>
    <string name="qemu_download_images_desc">aarch64 = same architecture as this phone (recommended, no cross-ISA translation). x86_64 = cross-arch (slower). Both run without KVM (software TCG). Alpine boots straight to login; Debian/Ubuntu cloud images are meant for cloud-init (they may need extra setup of a user/password to log in via console).</string>

    <string name="qemu_image_alpine_name">Alpine Linux 3.24 (virt, x86_64)</string>
    <string name="qemu_image_alpine_desc">Official minimal Alpine ISO — boots straight to root login without cloud-init, ideal for quickly testing the headless VM. Cross-arch on this phone (ARM64 host) — slower than the aarch64 variant below.</string>
    <string name="qemu_image_debian_name">Debian 12 (Bookworm) cloud, amd64</string>
    <string name="qemu_image_debian_desc">Official Debian cloud image (qcow2, ready for -drive). Meant for cloud-init — may need a seed ISO with a user/password to log in via console. Cross-arch on this phone — slower than the aarch64 variant below.</string>
    <string name="qemu_image_ubuntu_name">Ubuntu 22.04 LTS (Jammy) cloud, amd64</string>
    <string name="qemu_image_ubuntu_desc">Official Ubuntu Server cloud image. Same as Debian: meant for cloud-init, may need a separate seed to log in via console. Cross-arch on this phone — slower than the aarch64 variant below.</string>

    <string name="qemu_image_alpine_aarch64_name">Alpine Linux 3.24 (virt, aarch64) ★ recommended</string>
    <string name="qemu_image_alpine_aarch64_desc">Official minimal Alpine ISO for ARM64 — same architecture as this phone, no cross-ISA translation (faster than the x86_64 variant). Boots straight to root login without cloud-init.</string>
    <string name="qemu_image_debian_aarch64_name">Debian 12 (Bookworm) cloud, arm64 ★ recommended</string>
    <string name="qemu_image_debian_aarch64_desc">Official Debian cloud image for ARM64 (qcow2). Same architecture as this phone — faster than the amd64 variant above. Meant for cloud-init — may need a seed ISO with a user/password to log in via console.</string>
    <string name="qemu_image_ubuntu_aarch64_name">Ubuntu 22.04 LTS (Jammy) cloud, arm64 ★ recommended</string>
    <string name="qemu_image_ubuntu_aarch64_desc">Official Ubuntu Server cloud image for ARM64. Same architecture as this phone — faster than the amd64 variant above. Meant for cloud-init, may need a separate seed to log in via console.</string>

    <string name="qemu_card_vm_headless_title">HEADLESS VM (no KVM — software TCG)</string>
