    <string name="qemu_toast_qmp_paused">VM paused</string>
    <string name="qemu_toast_qmp_resumed">VM resumed</string>
    <string name="qemu_toast_qmp_screenshot_saved">Screenshot saved: %1$s (images folder)</string>

