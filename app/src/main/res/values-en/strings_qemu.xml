    <string name="qemu_card_terminal_title">TERMINAL</string>
    <string name="qemu_terminal_desc">For advanced users — opens a terminal already inside the images folder, to run qemu-system-x86_64 by hand (e.g. with -monitor stdio), inspect files, or check logs.</string>
    <string name="qemu_btn_open_terminal">💻 Open terminal</string>
    <string name="qemu_session_name_terminal">QEMU (Terminal)</string>

    <!-- SSH host→VM (hostfwd tcp::2222-:22, see run_vm.sh) + per-app X11 forwarding (ssh -X),
         see the connectSsh() comment in QemuFragment.kt -->
    <string name="qemu_btn_connect_ssh">🔑 Connect via SSH…</string>
    <string name="qemu_ssh_dialog_title">Connect via SSH to the VM</string>
    <string name="qemu_ssh_dialog_message">Guest username (e.g. root on Alpine; debian/ubuntu on the cloud images, if cloud-init already set a password/key). Host port %1$d forwards to port 22 on the VM. Connects with \"-X\" — this enables per-app X11 forwarding: if the VM has its own X server, you can open individual graphical programs from the VM without needing the whole desktop over VNC.</string>
    <string name="qemu_ssh_username_hint">Username (e.g. root)</string>
    <string name="qemu_ssh_connect_button">Connect</string>
    <string name="qemu_ssh_port_closed_title">Still not responding on port %1$d</string>
    <string name="qemu_ssh_port_closed_message">Nothing was detected listening on 127.0.0.1:%1$d — the VM may still be booting (software TCG without KVM takes a while), or the guest may not have sshd running/installed yet. You can try anyway (the ssh client will retry the real connection) or wait for it to finish booting.</string>
    <string name="qemu_ssh_try_anyway">Try anyway</string>
    <string name="qemu_session_name_ssh">QEMU (SSH)</string>

    <!-- Install a program inside the VM via SSH (explicit user request) — runs the real command
         in a visible terminal (not silent): installation may prompt for confirmation/password
         inside the guest, and neither the username nor a sudo package is guaranteed depending
         on the image (Alpine=apk without sudo by default, Debian/Ubuntu=apt with sudo if
         cloud-init set up a non-root user) — same honesty criterion as connectSsh()/
         promptConnectSsh(). -->
    <string name="qemu_btn_install_package">📦 Install a program in the VM (via SSH)…</string>
    <string name="qemu_install_pkg_title">Install a program in the VM</string>
    <string name="qemu_install_pkg_message">Runs the real installer via SSH in a visible terminal — if the guest asks for a sudo password or confirmation, answer it there. Pick the package manager that matches the image (apt for Debian/Ubuntu, apk for Alpine).</string>
    <string name="qemu_install_pkg_manager_label">Package manager</string>
    <string name="qemu_install_pkg_name_hint">Package name (e.g. git, htop, python3)</string>
    <string name="qemu_install_pkg_button">Install</string>
    <string name="qemu_toast_pkg_name_required">Type the package name first</string>
    <string name="qemu_session_name_install">QEMU (Install package)</string>

    <!-- Hot control via QMP (v1.4.0, see QmpClient.kt / finding #2 of
         docs/mini-pc/AUDITORIA_COMUNICACION_2026-09-08.md) -->
    <string name="qemu_card_qmp_title">HOT CONTROL (QMP)</string>
    <string name="qemu_qmp_desc">Controls the running VM without killing the process — requires having booted it (console or VNC mode) with this Kairos version. If no VM is running, each action warns instead of failing silently.</string>
    <string name="qemu_btn_qmp_powerdown">⏻ Power off (graceful)</string>
    <string name="qemu_btn_qmp_pause">⏸ Pause</string>
    <string name="qemu_btn_qmp_resume">▶ Resume</string>
    <string name="qemu_btn_qmp_screenshot">📷 Screenshot (QMP)</string>
    <string name="qemu_btn_qmp_change_media">💿 Change media (hot-swap)…</string>
    <string name="qemu_btn_qmp_eject_media">⏏ Eject media…</string>

    <string name="qemu_qmp_unavailable_title">No VM has QMP enabled</string>
    <string name="qemu_qmp_unavailable_message">No control socket was found for any running VM. Boot the VM first (\"Boot VM…\") — the QMP socket is enabled automatically in any mode (console or VNC).</string>

    <string name="qemu_qmp_powerdown_title">Power off the VM (graceful)</string>
    <string name="qemu_qmp_powerdown_message">Asks the guest to shut itself down (ACPI powerdown), like pressing the power button on a real PC — unlike \"Stop VM\", which kills the whole QEMU process outright. A minimal headless guest without acpid might not respond to this; if nothing happens in a few seconds, use \"Stop VM\".</string>
    <string name="qemu_qmp_powerdown_button">Power off</string>
    <string name="qemu_toast_qmp_powerdown_sent">Shutdown signal sent — wait for the guest to close on its own</string>
