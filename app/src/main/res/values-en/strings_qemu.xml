    <string name="qemu_card_download_images_title">IMAGES TO DOWNLOAD</string>
    <string name="qemu_download_images_desc">Guest x86_64 — run without KVM (software TCG, slow). Alpine boots straight to login; Debian/Ubuntu cloud images are meant for cloud-init (they may need extra setup of a user/password to log in via console).</string>

    <string name="qemu_image_alpine_name">Alpine Linux 3.24 (virt, x86_64)</string>
    <string name="qemu_image_alpine_desc">Official minimal Alpine ISO — boots straight to root login without cloud-init, ideal for quickly testing the headless VM.</string>
    <string name="qemu_image_debian_name">Debian 12 (Bookworm) cloud, amd64</string>
    <string name="qemu_image_debian_desc">Official Debian cloud image (qcow2, ready for -drive). Meant for cloud-init — may need a seed ISO with a user/password to log in via console.</string>
    <string name="qemu_image_ubuntu_name">Ubuntu 22.04 LTS (Jammy) cloud, amd64</string>
    <string name="qemu_image_ubuntu_desc">Official Ubuntu Server cloud image. Same as Debian: meant for cloud-init, may need a separate seed to log in via console.</string>

