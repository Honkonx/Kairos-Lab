    <string name="localai_model_qwencoder05b_name">Qwen2.5 Coder 0.5B Instruct</string>
    <string name="localai_model_qwencoder05b_desc">The smallest in the code catalog — autocompleting/explaining snippets on any device.</string>

    <string name="localai_model_deepseekr115b_name">DeepSeek R1 Distill Qwen 1.5B</string>
    <string name="localai_model_deepseekr115b_desc">DeepSeek\'s reasoning (chain-of-thought) model, distilled down to a small size.</string>

    <string name="localai_model_qwen34b_name">Qwen3 4B Instruct</string>
    <string name="localai_model_qwen34b_desc">Latest Qwen generation, reasoning improvements over Qwen2.5 at a similar size.</string>

    <string name="localai_model_gemma34b_name">Gemma 3 4B IT</string>
    <string name="localai_model_gemma34b_desc">Newer Gemma generation — better overall quality than Gemma 2 at a similar size.</string>

    <string name="localai_model_phi4mini_name">Phi-4 Mini Instruct</string>
    <string name="localai_model_phi4mini_desc">Small version of Microsoft\'s reasoning model — same lineage as Phi-4 14B with far less RAM.</string>

    <string name="localai_model_deepseekr17b_name">DeepSeek R1 Distill Qwen 7B</string>
    <string name="localai_model_deepseekr17b_desc">7B version of DeepSeek\'s reasoning model — more elaborate step-by-step responses.</string>

    <string name="localai_model_qwen38b_name">Qwen3 8B</string>
    <string name="localai_model_qwen38b_desc">8B version of Qwen3 — better quality than the 4B, needs more RAM.</string>

    <string name="localai_model_mistralnemo12b_name">Mistral NeMo 12B Instruct</string>
    <string name="localai_model_mistralnemo12b_desc">Mistral AI + NVIDIA collaboration, long context (128K), 12B.</string>

    <string name="localai_model_gemma312b_name">Gemma 3 12B IT</string>
    <string name="localai_model_gemma312b_desc">Larger version of Gemma 3 — better reasoning than the 4B, needs considerably more RAM.</string>

    <string name="localai_model_qwencoder14b_name">Qwen2.5 Coder 14B Instruct</string>
    <string name="localai_model_qwencoder14b_desc">The largest code model in the catalog — better for complex programming tasks, needs a fair amount of RAM.</string>

