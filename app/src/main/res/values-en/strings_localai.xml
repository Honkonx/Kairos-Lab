<resources>
    <!-- LocalAIFragment.kt — GGUF model catalog -->
    <string name="localai_model_qwen05b_name">Qwen2.5 0.5B Instruct</string>
    <string name="localai_model_qwen05b_desc">The smallest and fastest in the catalog — ideal for testing the local engine on any device.</string>

    <string name="localai_model_tinyllama11b_name">TinyLlama 1.1B Chat</string>
    <string name="localai_model_tinyllama11b_desc">One of the lightest models available in GGUF — starts up fast on any hardware.</string>

    <string name="localai_model_smollm217b_name">SmolLM2 1.7B Instruct</string>
    <string name="localai_model_smollm217b_desc">Model from HuggingFaceTB trained to run well on devices with limited RAM.</string>

    <string name="localai_model_qwencoder15b_name">Qwen2.5 Coder 1.5B Instruct</string>
    <string name="localai_model_qwencoder15b_desc">Qwen2.5 variant specialized in code, small size for autocompleting/explaining snippets.</string>

    <string name="localai_model_qwen15b_name">Qwen2.5 1.5B Instruct</string>
    <string name="localai_model_qwen15b_desc">Balance between speed and response quality, a good default for mid-range devices.</string>

    <string name="localai_model_llama321b_name">Llama 3.2 1B Instruct</string>
    <string name="localai_model_llama321b_desc">Official Meta model, quantized by bartowski — good quality for its size.</string>

    <string name="localai_model_gemma22b_name">Gemma 2 2B IT</string>
    <string name="localai_model_gemma22b_desc">Google model, good performance in Spanish and general reasoning.</string>

    <string name="localai_model_qwencoder3b_name">Qwen2.5 Coder 3B Instruct</string>
    <string name="localai_model_qwencoder3b_desc">Mid-size version of Qwen\'s code model — more useful context than the 1.5B.</string>

    <string name="localai_model_qwen3b_name">Qwen2.5 3B Instruct</string>
    <string name="localai_model_qwen3b_desc">Intermediate step between the 1.5B and Llama\'s 3.2 — good RAM/quality balance.</string>

    <string name="localai_model_llama323b_name">Llama 3.2 3B Instruct</string>
    <string name="localai_model_llama323b_desc">Better response quality than the previous ones, but needs more RAM and storage.</string>

    <string name="localai_model_phi3mini_name">Phi-3 Mini 4K Instruct</string>
    <string name="localai_model_phi3mini_desc">Microsoft model (3.8B), strong reasoning for its size, 4K token context.</string>

    <string name="localai_model_phi35mini_name">Phi-3.5 Mini Instruct</string>
    <string name="localai_model_phi35mini_desc">Successor to Phi-3 Mini, same size (3.8B) with quality improvements from Microsoft.</string>

    <string name="localai_model_qwen7b_name">Qwen2.5 7B Instruct</string>
    <string name="localai_model_qwen7b_desc">Mid-size Alibaba model, good quality-to-size ratio for general reasoning.</string>

    <string name="localai_model_qwencoder7b_name">Qwen2.5 Coder 7B Instruct</string>
    <string name="localai_model_qwencoder7b_desc">Larger version of Qwen\'s code model — better for complex programming tasks.</string>

    <string name="localai_model_mistral7b_name">Mistral 7B Instruct v0.3</string>
    <string name="localai_model_mistral7b_desc">Mistral AI\'s reference model, a reliable classic in the 7B range.</string>

    <string name="localai_model_openhermes7b_name">OpenHermes 2.5 Mistral 7B</string>
    <string name="localai_model_openhermes7b_desc">Community fine-tune of Mistral 7B, widely used for general-purpose chat.</string>

    <string name="localai_model_llama38b_name">Meta Llama 3 8B Instruct</string>
    <string name="localai_model_llama38b_desc">Previous generation of Meta\'s Llama at 8B — still widely used as a reference.</string>

    <string name="localai_model_llama318b_name">Meta Llama 3.1 8B Instruct</string>
    <string name="localai_model_llama318b_desc">Official Meta model, quality reference in the 8B range.</string>

    <string name="localai_model_gemma29b_name">Gemma 2 9B IT</string>
    <string name="localai_model_gemma29b_desc">Larger version of Gemma 2 — better reasoning than the 2B, needs considerably more RAM.</string>

    <string name="localai_model_qwen14b_name">Qwen2.5 14B Instruct</string>
    <string name="localai_model_qwen14b_desc">The largest in the catalog — best quality, but needs a fair amount of RAM (8GB+ recommended) and storage.</string>

    <string name="localai_model_phi414b_name">Phi-4 14B</string>
    <string name="localai_model_phi414b_desc">Microsoft\'s reasoning model (14B) — one of the best-quality options in the catalog.</string>

